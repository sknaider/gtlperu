# AI ML Studio - Environment Variables

# ===========================
# API Keys
# ===========================
ANTHROPIC_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
WANDB_API_KEY=your_wandb_api_key_here
HUGGINGFACE_TOKEN=your_hf_token_here

# ===========================
# Database Configuration
# ===========================
DATABASE_URL=postgresql://aimluser:aimlpassword@localhost:5432/aimlstudio
POSTGRES_USER=aimluser
POSTGRES_PASSWORD=aimlpassword
POSTGRES_DB=aimlstudio

# ===========================
# Redis Configuration
# ===========================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===========================
# Vector Database (ChromaDB)
# ===========================
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ===========================
# Storage Paths
# ===========================
MODEL_STORAGE_PATH=./models
DATA_STORAGE_PATH=./data
CHECKPOINT_PATH=./models/checkpoints
LOGS_PATH=./logs

# ===========================
# Training Configuration
# ===========================
DEFAULT_BATCH_SIZE=32
DEFAULT_EPOCHS=10
DEFAULT_LEARNING_RATE=0.001
MIXED_PRECISION=true
GRADIENT_CHECKPOINTING=false

# ===========================
# GPU Configuration
# ===========================
CUDA_VISIBLE_DEVICES=0
USE_GPU=true
MULTI_GPU=false
GPU_MEMORY_FRACTION=0.9

# ===========================
# MLflow Configuration
# ===========================
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=ai-ml-studio
MLFLOW_ARTIFACT_ROOT=./mlruns

# ===========================
# API Configuration
# ===========================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ===========================
# Frontend Configuration
# ===========================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ===========================
# Security
# ===========================
SECRET_KEY=your_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================
# Celery Configuration
# ===========================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===========================
# Logging
# ===========================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===========================
# Rate Limiting
# ===========================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ===========================
# Cache
# ===========================
CACHE_TTL=3600
CACHE_ENABLED=true

# ===========================
# Model Defaults
# ===========================
DEFAULT_MODEL_NAME=gpt2
DEFAULT_TOKENIZER=gpt2
MAX_SEQ_LENGTH=512

# ===========================
# Dataset Generation
# ===========================
SYNTHETIC_DATA_SAMPLES=1000
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=1.0

# ===========================
# RAG Configuration
# ===========================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RESULTS=5

# ===========================
# Monitoring
# ===========================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ===========================
# Development
# ===========================
DEBUG=false
TESTING=false
ENVIRONMENT=development
